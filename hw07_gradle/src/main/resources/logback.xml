<configuration>
    <property resource="logback.properties" />
<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
        <charset>UTF-8</charset>
        <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
    </encoder>
</appender>
    <appender name="LISTENER" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${file.listener}</file>
        <!-- Ротация каждый день -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${file.listener}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>32MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="PROCESSORS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${file.processors}</file>
        <!-- Ротация каждый день -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${file.processors}.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>32MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LISTENER" />
        <appender-ref ref="PROCESSORS" />
        </root>
    <logger name="org.example.homework.listener.homework.HistoryListener" level="INFO" additivity="false">
        <appender-ref ref="LISTENER" />
    </logger>
    <logger name="org.example.homework.processor" level="INFO" additivity="false">
        <appender-ref ref="PROCESSORS" />
    </logger>
    <logger name="org.example.homework" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
         </logger>
   </configuration>